{
  "name": "noir",
  "description": "A precise music application wrapped around expressive visual worlds.",
  "private": true,
  "version": "1.0.0",
  "author": "Antigravity & Elva Team",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "prefetch:charts": "node scripts/prefetch-charts.mjs",
    "build": "npm run prefetch:charts && vite build",
    "dev": "vite",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@radix-ui/react-slider": "1.2.3",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "^10.0.1",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "tailwindcss": "4.1.12",
    "vite": "6.3.5",
    "wait-on": "^9.0.10"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  },
  "build": {
    "appId": "com.elva.app",
    "productName": "Elva",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg"
      ]
    }
  }
}
